{
  "name": "native-gated-merge",
  "roles": [
    {
      "id": "reviewer",
      "queues": []
    },
    {
      "id": "owner",
      "queues": []
    }
  ],
  "labels": [
    {
      "id": "implementation"
    },
    {
      "id": "landed"
    }
  ],
  "artifact_kinds": [
    {
      "id": "implementation_pr",
      "target": "pull_request",
      "identifying_labels": [
        "implementation"
      ]
    }
  ],
  "state_dimensions": [
    {
      "id": "post_merge",
      "exclusive": false,
      "states": [
        {
          "id": "landed",
          "label": "landed"
        }
      ]
    }
  ],
  "transitions": [
    {
      "id": "approve_review",
      "artifact": "implementation_pr",
      "roles": [
        "reviewer"
      ],
      "effects": [
        {
          "kind": "submit_review",
          "decision": "approved"
        }
      ]
    },
    {
      "id": "approve_merge",
      "artifact": "implementation_pr",
      "roles": [
        "owner"
      ],
      "requires_gates": [
        "ci_gate",
        "review_gate"
      ],
      "effects": [
        {
          "kind": "merge_pull_request"
        },
        {
          "kind": "add_label",
          "label": "landed"
        }
      ]
    }
  ],
  "gates": [
    {
      "id": "ci_gate",
      "condition": {
        "kind": "ci_passed"
      }
    },
    {
      "id": "review_gate",
      "condition": {
        "kind": "review_approved"
      }
    }
  ]
}
