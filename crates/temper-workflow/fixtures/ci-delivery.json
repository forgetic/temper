{
  "name": "ci-delivery",
  "roles": [
    {
      "id": "architect",
      "charter": "Turn human requests into epics, design issues, and ready code issues. Escalate unclear long-term direction to the owner.",
      "concurrency": 1,
      "queues": [
        "design_triage"
      ]
    },
    {
      "id": "engineer",
      "charter": "Claim ready code issues, implement them, open pull requests, and address failed review or CI gates.",
      "concurrency": 3,
      "queues": [
        "code_ready",
        "pr_changes_requested",
        "pr_ci_failed"
      ]
    },
    {
      "id": "reviewer",
      "charter": "Review pull requests for correctness and clarity. Approve or request changes.",
      "concurrency": 2,
      "queues": [
        "pr_needs_review"
      ]
    },
    {
      "id": "owner",
      "charter": "Resolve items needing owner judgment and approve merges once gates pass.",
      "concurrency": 1,
      "queues": [
        "needs_owner"
      ]
    }
  ],
  "labels": [
    {
      "id": "epic",
      "description": "identifies an epic"
    },
    {
      "id": "design",
      "description": "identifies a design issue"
    },
    {
      "id": "code",
      "description": "identifies a code issue"
    },
    {
      "id": "implementation",
      "description": "identifies an implementation pull request"
    },
    {
      "id": "design-draft",
      "description": "design is still being shaped"
    },
    {
      "id": "design-ready",
      "description": "design is ready to break into code issues"
    },
    {
      "id": "ready",
      "description": "code issue is ready to claim"
    },
    {
      "id": "blocked",
      "description": "code issue is blocked on a dependency"
    },
    {
      "id": "in-progress",
      "description": "code issue is being implemented"
    },
    {
      "id": "needs-review",
      "description": "pull request awaits review"
    },
    {
      "id": "landed",
      "description": "merged PR awaiting architect reconcile"
    },
    {
      "id": "alignment",
      "description": "merged PR awaiting owner alignment"
    },
    {
      "id": "needs-owner",
      "description": "requires owner judgment"
    }
  ],
  "artifact_kinds": [
    {
      "id": "epic",
      "target": "issue",
      "identifying_labels": [
        "epic"
      ]
    },
    {
      "id": "design",
      "target": "issue",
      "identifying_labels": [
        "design"
      ]
    },
    {
      "id": "code",
      "target": "issue",
      "identifying_labels": [
        "code"
      ]
    },
    {
      "id": "implementation_pr",
      "target": "pull_request",
      "identifying_labels": [
        "implementation"
      ]
    }
  ],
  "relations": [
    {
      "kind": "dependency",
      "source": "code",
      "target": "code"
    }
  ],
  "state_dimensions": [
    {
      "id": "design_lifecycle",
      "exclusive": true,
      "states": [
        {
          "id": "draft",
          "label": "design-draft"
        },
        {
          "id": "ready",
          "label": "design-ready"
        }
      ]
    },
    {
      "id": "code_lifecycle",
      "exclusive": true,
      "states": [
        {
          "id": "ready",
          "label": "ready"
        },
        {
          "id": "blocked",
          "label": "blocked"
        },
        {
          "id": "in_progress",
          "label": "in-progress"
        }
      ]
    },
    {
      "id": "post_merge",
      "exclusive": false,
      "states": [
        {
          "id": "landed",
          "label": "landed"
        },
        {
          "id": "alignment",
          "label": "alignment"
        }
      ]
    },
    {
      "id": "owner_attention",
      "exclusive": false,
      "states": [
        {
          "id": "needs_owner",
          "label": "needs-owner"
        }
      ]
    }
  ],
  "queues": [
    {
      "id": "design_triage",
      "artifact": "design",
      "labels": [
        "design-draft"
      ]
    },
    {
      "id": "code_ready",
      "artifact": "code",
      "labels": [
        "ready"
      ]
    },
    {
      "id": "pr_needs_review",
      "artifact": "implementation_pr",
      "labels": [
        "needs-review"
      ]
    },
    {
      "id": "pr_changes_requested",
      "artifact": "implementation_pr",
      "condition": {
        "kind": "review_changes_requested"
      }
    },
    {
      "id": "pr_ci_failed",
      "artifact": "implementation_pr",
      "condition": {
        "kind": "ci_failed"
      }
    },
    {
      "id": "needs_owner",
      "artifact": "design",
      "labels": [
        "needs-owner"
      ]
    },
    {
      "id": "blocked_terminal_recovery",
      "artifact": "code",
      "labels": [
        "blocked"
      ],
      "condition": {
        "kind": "dependencies_resolved"
      },
      "terminal": true
    },
    {
      "id": "post_merge_recovery",
      "artifact": "implementation_pr",
      "any_of": [
        { "labels": ["landed"] },
        { "labels": ["alignment"] }
      ],
      "terminal": true
    }
  ],
  "transitions": [
    {
      "id": "refine_design",
      "artifact": "design",
      "roles": [
        "architect"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "design-draft"
        },
        {
          "kind": "add_label",
          "label": "design-ready"
        }
      ]
    },
    {
      "id": "escalate_to_owner",
      "artifact": "design",
      "roles": [
        "architect"
      ],
      "effects": [
        {
          "kind": "add_label",
          "label": "needs-owner"
        }
      ]
    },
    {
      "id": "mark_code_ready",
      "artifact": "code",
      "roles": [
        "architect"
      ],
      "requires_gates": [
        "dependency_gate"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "blocked"
        },
        {
          "kind": "add_label",
          "label": "ready"
        }
      ]
    },
    {
      "id": "claim_code",
      "artifact": "code",
      "roles": [
        "engineer"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "ready"
        },
        {
          "kind": "add_label",
          "label": "in-progress"
        }
      ]
    },
    {
      "id": "request_review",
      "artifact": "implementation_pr",
      "roles": [
        "engineer"
      ],
      "effects": [
        {
          "kind": "add_label",
          "label": "needs-review"
        },
        {
          "kind": "request_reviewers",
          "roles": [
            "reviewer"
          ]
        }
      ]
    },
    {
      "id": "address_review_changes",
      "artifact": "implementation_pr",
      "roles": [
        "engineer"
      ],
      "effects": [
        {
          "kind": "add_label",
          "label": "needs-review"
        },
        {
          "kind": "request_reviewers",
          "roles": [
            "reviewer"
          ]
        }
      ]
    },
    {
      "id": "address_ci_failure",
      "artifact": "implementation_pr",
      "roles": [
        "engineer"
      ],
      "effects": [
        {
          "kind": "add_label",
          "label": "needs-review"
        },
        {
          "kind": "request_reviewers",
          "roles": [
            "reviewer"
          ]
        }
      ]
    },
    {
      "id": "approve_review",
      "artifact": "implementation_pr",
      "roles": [
        "reviewer"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "needs-review"
        },
        {
          "kind": "submit_review",
          "decision": "approved"
        }
      ]
    },
    {
      "id": "request_changes",
      "artifact": "implementation_pr",
      "roles": [
        "reviewer"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "needs-review"
        },
        {
          "kind": "submit_review",
          "decision": "changes_requested"
        }
      ]
    },
    {
      "id": "clear_owner_flag",
      "artifact": "design",
      "roles": [
        "owner"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "needs-owner"
        }
      ]
    },
    {
      "id": "approve_merge",
      "artifact": "implementation_pr",
      "roles": [
        "owner"
      ],
      "requires_gates": [
        "review_gate",
        "ci_gate"
      ],
      "effects": [
        {
          "kind": "merge_pull_request"
        },
        {
          "kind": "add_label",
          "label": "landed"
        },
        {
          "kind": "add_label",
          "label": "alignment"
        }
      ]
    }
  ],
  "gates": [
    {
      "id": "review_gate",
      "condition": {
        "kind": "review_approved"
      }
    },
    {
      "id": "ci_gate",
      "condition": {
        "kind": "ci_passed"
      }
    },
    {
      "id": "dependency_gate",
      "condition": {
        "kind": "dependencies_resolved"
      }
    }
  ]
}
