{
  "name": "reference-delivery",
  "roles": [
    {
      "id": "architect",
      "charter": "Turn requests into epics, design issues, and ready code issues; resolve escalations; reconcile landed PRs.",
      "concurrency": 1,
      "queues": [
        "design_triage",
        "escalations",
        "landed_inbox"
      ]
    },
    {
      "id": "engineer",
      "charter": "Claim ready code issues, implement them, open PRs, and address failed review or testing gates.",
      "concurrency": 3,
      "queues": [
        "code_ready",
        "pr_changes_requested",
        "pr_test_failed"
      ]
    },
    {
      "id": "reviewer",
      "charter": "Statically review PRs against the contract catalog; approve or request changes.",
      "concurrency": 2,
      "queues": [
        "pr_needs_review"
      ]
    },
    {
      "id": "tester",
      "charter": "Exercise the change and record whether testing passed or failed.",
      "concurrency": 2,
      "queues": [
        "pr_needs_testing"
      ]
    },
    {
      "id": "owner",
      "charter": "Resolve needs-human items and run holistic alignment review of landed cohorts.",
      "concurrency": 1,
      "queues": [
        "needs_human",
        "owner_alignment"
      ]
    }
  ],
  "labels": [
    {
      "id": "untriaged",
      "description": "human-filed issue awaiting triage by the architect"
    },
    {
      "id": "epic",
      "description": "identifies a long-lived epic issue"
    },
    {
      "id": "design",
      "description": "identifies a design issue"
    },
    {
      "id": "code",
      "description": "identifies a code issue"
    },
    {
      "id": "implementation",
      "description": "identifies an implementation pull request"
    },
    {
      "id": "draft",
      "description": "work item is still being shaped"
    },
    {
      "id": "ready",
      "description": "work item is ready for the next workflow step"
    },
    {
      "id": "in-progress",
      "description": "work item is currently being advanced"
    },
    {
      "id": "blocked",
      "description": "work item is blocked by unmet dependencies"
    },
    {
      "id": "needs-review",
      "description": "pull request awaits review"
    },
    {
      "id": "needs-testing",
      "description": "pull request awaits testing"
    },
    {
      "id": "testing-passed",
      "description": "testing passed"
    },
    {
      "id": "testing-failed",
      "description": "testing failed"
    },
    {
      "id": "escalated",
      "description": "judgment escalation flag routed to the architect"
    },
    {
      "id": "needs-human",
      "description": "owner-input flag routed to the owner"
    },
    {
      "id": "landed",
      "description": "merged PR awaiting architect reconcile"
    },
    {
      "id": "owner-pending",
      "description": "merged PR awaiting owner alignment review"
    }
  ],
  "artifact_kinds": [
    {
      "id": "intake",
      "target": "issue",
      "identifying_labels": [
        "untriaged"
      ]
    },
    {
      "id": "epic",
      "target": "issue",
      "identifying_labels": [
        "epic"
      ]
    },
    {
      "id": "design",
      "target": "issue",
      "identifying_labels": [
        "design"
      ]
    },
    {
      "id": "code",
      "target": "issue",
      "identifying_labels": [
        "code"
      ]
    },
    {
      "id": "implementation_pr",
      "target": "pull_request",
      "identifying_labels": [
        "implementation"
      ]
    }
  ],
  "relations": [
    {
      "kind": "parent",
      "source": "design",
      "target": "epic"
    },
    {
      "kind": "parent",
      "source": "code",
      "target": "design"
    },
    {
      "kind": "parent",
      "source": "code",
      "target": "epic"
    },
    {
      "kind": "dependency",
      "source": "code",
      "target": "code"
    },
    {
      "kind": "produced_pr",
      "source": "implementation_pr",
      "target": "code"
    }
  ],
  "state_dimensions": [
    {
      "id": "work_lifecycle",
      "exclusive": true,
      "states": [
        {
          "id": "draft",
          "label": "draft",
          "artifacts": [
            "design"
          ]
        },
        {
          "id": "ready",
          "label": "ready",
          "artifacts": [
            "design",
            "code"
          ]
        },
        {
          "id": "in_progress",
          "label": "in-progress",
          "artifacts": [
            "epic",
            "code"
          ]
        },
        {
          "id": "blocked",
          "label": "blocked",
          "artifacts": [
            "code"
          ]
        }
      ]
    },
    {
      "id": "testing",
      "exclusive": true,
      "states": [
        {
          "id": "needs_testing",
          "label": "needs-testing"
        },
        {
          "id": "passed",
          "label": "testing-passed"
        },
        {
          "id": "failed",
          "label": "testing-failed"
        }
      ]
    },
    {
      "id": "escalation",
      "exclusive": false,
      "states": [
        {
          "id": "escalated",
          "label": "escalated"
        }
      ]
    },
    {
      "id": "human",
      "exclusive": false,
      "states": [
        {
          "id": "needs_human",
          "label": "needs-human"
        }
      ]
    },
    {
      "id": "post_merge",
      "exclusive": false,
      "states": [
        {
          "id": "landed",
          "label": "landed"
        },
        {
          "id": "owner_pending",
          "label": "owner-pending"
        }
      ]
    }
  ],
  "queues": [
    {
      "id": "design_triage",
      "artifact": "intake",
      "labels": [
        "untriaged"
      ]
    },
    {
      "id": "code_ready",
      "artifact": "code",
      "labels": [
        "ready"
      ]
    },
    {
      "id": "pr_needs_review",
      "artifact": "implementation_pr",
      "labels": [
        "needs-review"
      ]
    },
    {
      "id": "pr_needs_testing",
      "artifact": "implementation_pr",
      "labels": [
        "needs-testing"
      ]
    },
    {
      "id": "pr_changes_requested",
      "artifact": "implementation_pr",
      "condition": {
        "kind": "review_changes_requested"
      }
    },
    {
      "id": "pr_test_failed",
      "artifact": "implementation_pr",
      "labels": [
        "testing-failed"
      ]
    },
    {
      "id": "escalations",
      "artifact": [
        "intake",
        "epic",
        "design",
        "code",
        "implementation_pr"
      ],
      "labels": [
        "escalated"
      ]
    },
    {
      "id": "needs_human",
      "artifact": [
        "intake",
        "epic",
        "design",
        "code",
        "implementation_pr"
      ],
      "labels": [
        "needs-human"
      ]
    },
    {
      "id": "landed_inbox",
      "artifact": "implementation_pr",
      "labels": [
        "landed"
      ]
    },
    {
      "id": "owner_alignment",
      "artifact": "implementation_pr",
      "labels": [
        "owner-pending"
      ],
      "min_depth": 5,
      "max_age": 604800
    }
  ],
  "transitions": [
    {
      "id": "triage_to_code",
      "artifact": "intake",
      "roles": [
        "architect"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "untriaged"
        },
        {
          "kind": "add_label",
          "label": "code"
        },
        {
          "kind": "add_label",
          "label": "ready"
        }
      ]
    },
    {
      "id": "triage_to_design",
      "artifact": "intake",
      "roles": [
        "architect"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "untriaged"
        },
        {
          "kind": "add_label",
          "label": "design"
        },
        {
          "kind": "add_label",
          "label": "draft"
        }
      ]
    },
    {
      "id": "refine_design",
      "artifact": "design",
      "roles": [
        "architect"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "draft"
        },
        {
          "kind": "add_label",
          "label": "ready"
        }
      ]
    },
    {
      "id": "mark_code_ready",
      "artifact": "code",
      "roles": [
        "architect"
      ],
      "requires_gates": [
        "dependency_gate"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "blocked"
        },
        {
          "kind": "add_label",
          "label": "ready"
        }
      ]
    },
    {
      "id": "reconcile_landed",
      "artifact": "implementation_pr",
      "roles": [
        "architect"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "landed"
        }
      ]
    },
    {
      "id": "resolve_escalation",
      "artifact": "implementation_pr",
      "roles": [
        "architect"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "escalated"
        }
      ]
    },
    {
      "id": "request_human_input",
      "artifact": "implementation_pr",
      "roles": [
        "architect"
      ],
      "effects": [
        {
          "kind": "add_label",
          "label": "needs-human"
        }
      ]
    },
    {
      "id": "claim_code",
      "artifact": "code",
      "roles": [
        "engineer"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "ready"
        },
        {
          "kind": "add_label",
          "label": "in-progress"
        },
        {
          "kind": "set_assignee",
          "role": "engineer"
        }
      ]
    },
    {
      "id": "open_pr",
      "artifact": "code",
      "roles": [
        "engineer"
      ],
      "effects": [
        {
          "kind": "create_pull_request"
        }
      ]
    },
    {
      "id": "request_review",
      "artifact": "implementation_pr",
      "roles": [
        "engineer"
      ],
      "effects": [
        {
          "kind": "add_label",
          "label": "needs-review"
        },
        {
          "kind": "request_reviewers",
          "roles": [
            "reviewer"
          ]
        }
      ]
    },
    {
      "id": "address_review_changes",
      "artifact": "implementation_pr",
      "roles": [
        "engineer"
      ],
      "effects": [
        {
          "kind": "add_label",
          "label": "needs-review"
        },
        {
          "kind": "request_reviewers",
          "roles": [
            "reviewer"
          ]
        }
      ]
    },
    {
      "id": "address_test_failure",
      "artifact": "implementation_pr",
      "roles": [
        "engineer"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "testing-failed"
        },
        {
          "kind": "add_label",
          "label": "needs-testing"
        }
      ]
    },
    {
      "id": "escalate_pr",
      "artifact": "implementation_pr",
      "roles": [
        "engineer",
        "reviewer",
        "tester"
      ],
      "effects": [
        {
          "kind": "add_label",
          "label": "escalated"
        }
      ]
    },
    {
      "id": "approve_review",
      "artifact": "implementation_pr",
      "roles": [
        "reviewer"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "needs-review"
        },
        {
          "kind": "submit_review",
          "decision": "approved"
        }
      ]
    },
    {
      "id": "request_changes",
      "artifact": "implementation_pr",
      "roles": [
        "reviewer"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "needs-review"
        },
        {
          "kind": "submit_review",
          "decision": "changes_requested"
        }
      ]
    },
    {
      "id": "record_test_pass",
      "artifact": "implementation_pr",
      "roles": [
        "tester"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "needs-testing"
        },
        {
          "kind": "add_label",
          "label": "testing-passed"
        }
      ]
    },
    {
      "id": "record_test_failure",
      "artifact": "implementation_pr",
      "roles": [
        "tester"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "needs-testing"
        },
        {
          "kind": "add_label",
          "label": "testing-failed"
        }
      ]
    },
    {
      "id": "clear_human_flag",
      "artifact": "implementation_pr",
      "roles": [
        "owner"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "needs-human"
        }
      ]
    },
    {
      "id": "review_alignment",
      "artifact": "implementation_pr",
      "roles": [
        "owner"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "owner-pending"
        }
      ]
    },
    {
      "id": "approve_merge",
      "artifact": "implementation_pr",
      "roles": [
        "owner"
      ],
      "requires_gates": [
        "review_gate",
        "testing_gate",
        "ci_gate"
      ],
      "effects": [
        {
          "kind": "merge_pull_request"
        },
        {
          "kind": "add_label",
          "label": "landed"
        },
        {
          "kind": "add_label",
          "label": "owner-pending"
        }
      ]
    }
  ],
  "gates": [
    {
      "id": "review_gate",
      "condition": {
        "kind": "review_approved"
      }
    },
    {
      "id": "testing_gate",
      "satisfied_by": [
        "record_test_pass"
      ]
    },
    {
      "id": "ci_gate",
      "condition": {
        "kind": "ci_passed"
      }
    },
    {
      "id": "dependency_gate",
      "condition": {
        "kind": "dependencies_resolved"
      }
    }
  ]
}
