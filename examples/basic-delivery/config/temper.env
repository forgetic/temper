# basic-delivery example — operator-editable configuration (NO SECRETS).
#
# This file is sourced by run.sh. It carries only knobs an operator may change;
# CLI/env overrides win over values set here, which in turn override built-in
# defaults. The launcher now demonstrates the long-term local-dev flow:
#
#   Forgejo + runner -> local jig fake LLM -> temper init --non-interactive ->
#   explicit initial repo commit -> temper serve standalone -> site-admin intake.
#
# `temper init` emits run/config.toml, run/credentials.toml, run/workflow.json,
# and run/webhook-secret. run.sh consumes those emitted artifacts directly; it no
# longer provisions CI/content through a legacy provisioning command and does not
# require real LLM credentials for the happy path. Jig ignores the dummy provider
# key that init stores in credentials.toml.

# --- Repository ---------------------------------------------------------------
# Single repo only: this example is deliberately one converging happy path. init
# provisions OWNER/NAME as an empty/non-auto-initialized repository; run.sh then
# creates the first DEFAULT_BRANCH commit explicitly.
OWNER=acme
NAME=service
DEFAULT_BRANCH=main

# --- Seeded intake issue ------------------------------------------------------
# The single intake issue the site admin (external filer) files after
# `temper serve standalone` is ready. It is DELIBERATELY THIN: it declares only
# the overall intent, with no acceptance criteria, no setting name, and no
# implementation detail. The architect must rewrite this stub into a complete,
# implementable code spec during triage.
#
# Paths are resolved relative to this config/ directory by run.sh.
INTAKE_TITLE='Service banner should identify the environment'
INTAKE_BODY_FILE=intake-issue.md

# --- Forgejo + Temper endpoints ----------------------------------------------
# Where the bundled throwaway Forgejo server listens. Distinct from
# reference-delivery (4200 / 38200) so both demos can run side by side.
BASE_URL=http://127.0.0.1:4100

# The standalone daemon bind address. `temper init --bind` derives the Forgejo
# webhook URL as http://$DAEMON_BIND/forgejo/webhook and registers it.
DAEMON_BIND=127.0.0.1:38100

# Long role poll backstop so webhooks demonstrably drive progress; short
# mechanical cadence because Forgejo 7.0.x has no Actions-completion webhook and
# landing needs CI-read polling. run.sh patches these demo-only runtime knobs
# into the init-emitted config.toml rather than hand-writing a replacement config.
DAEMON_POLL_CADENCE_SECS=120
DAEMON_MECHANICAL_CADENCE_SECS=2
DAEMON_LEASE_TTL_SECS=300

# Hard backstop on how long the launcher blocks before tearing the run down.
RUN_SECS=600

# --- Local jig fake LLM -------------------------------------------------------
# By default the launcher starts a local jig checkout from ~/src/rust/jig with
# the Temper basic-delivery phase fixture. Override any of these when jig lives
# elsewhere or when using a prebuilt binary. Relative JIG_FIXTURE paths are
# resolved under JIG_REPO.
JIG_REPO=$HOME/src/rust/jig
JIG_BIN=
JIG_FIXTURE=fixtures/basic-delivery.json
TEMPER_SKIP_JIG_BUILD=0

# Dummy DeepSeek-compatible provider key passed to `temper init` through
# TEMPER_INIT_PROVIDER_KEY. Jig accepts and ignores Authorization headers.
INIT_PROVIDER_KEY=basic-delivery-jig-dummy-key

# --- CPU cap (lesson 0009) ----------------------------------------------------
# Cap GOMAXPROCS for the spawned Forgejo server and runner (both Go programs).
# Set empty to opt out. Default 2.
TEMPER_FORGEJO_GOMAXPROCS=2

# --- Cached pinned binaries ---------------------------------------------------
# Absolute paths to Forgejo 7.0.12 and forgejo-runner 3.5.1. Leave empty for the
# shared .cache/forgejo/ paths. Ignored Forgejo fixture tests fill that cache
# automatically on first startup when network access is available.
TEMPER_FORGEJO_BINARY=
TEMPER_FORGEJO_RUNNER_BINARY=

# --- Temper entry-point binary -----------------------------------------------
# The example targets the single unified `temper` binary (it provides
# `temper init` and `temper serve standalone`). Leave TEMPER_RUN_BIN empty for
# the workspace target/debug default. TEMPER_BUILD_PACKAGE is the package run.sh
# builds in the development profile unless TEMPER_SKIP_BUILD=1.
TEMPER_RUN_BIN=
TEMPER_BUILD_PACKAGE=temper

# --- Coding agent limits ------------------------------------------------------
# Max agent iterations per job. The agent's own default is 250; lower it for a
# tighter/cheaper demo. With jig, no real tokens are spent.
RUN_MAX_ITERATIONS=250
