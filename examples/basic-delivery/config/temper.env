# basic-delivery example — operator-editable configuration (NO SECRETS).
#
# This file is sourced by run.sh. It carries only knobs an operator may change;
# CLI/env overrides win over values set here, which in turn override the binary's
# own defaults. The launcher runs a single `temper run` process (the unified
# daemon + worker + REAL in-process coding agent), plus a real throwaway Forgejo
# and a real host-mode forgejo-runner. It is the minimal, single-repo,
# no-human-in-the-loop counterpart to reference-delivery: ONE repo, the three
# basic-delivery roles (architect, engineer, and the bot mechanical authority),
# and landing gated on CI alone — no reviewer, no owner, no human.
#
# Secrets (per-role tokens/passwords, any provider API key) never live here — see
# ../secrets/ and ../secrets/.env.example.

# --- Repository ---------------------------------------------------------------
# Single repo only: this example is deliberately one converging happy path. The
# launcher provisions and scans exactly OWNER/NAME (there is no REPOS set and no
# cross-repo intake).
OWNER=acme
NAME=service

# Default branch the repo is initialized with (the implementation PR targets it).
DEFAULT_BRANCH=main

# --- Workflow -----------------------------------------------------------------
# The bundled 3-role basic-delivery spec, passed to BOTH temper-provision-forgejo
# and `temper run` via --workflow. It declares intake_author = site_admin, so
# run.sh files the intake issue through Forgejo's API as the setup-only site
# admin rather than a `human` role.
#
# A relative path is taken relative to config/; an absolute path is used verbatim.
# config/workflow.json tracks the canonical fixture
# crates/temper-workflow/fixtures/basic-delivery.json — keep the two in sync.
WORKFLOW_FILE=workflow.json

# --- Seeded intake issue ------------------------------------------------------
# The single intake issue the site admin (external filer) files. It is
# DELIBERATELY THIN: it declares only the overall intent, with no acceptance
# criteria, no setting name, and no implementation detail. The architect must
# rewrite this stub into a complete, implementable code spec during triage (the
# triage_intake_to_code set_body effect) — that is what this example proves the
# architect can do. Do NOT pre-bake the design here; keep the body intent-only.
#
# Paths are resolved relative to this config/ directory by run.sh.
INTAKE_TITLE='Service banner should identify the environment'
INTAKE_BODY_FILE=intake-issue.md

# --- Forgejo + daemon endpoints ----------------------------------------------
# Where the bundled throwaway Forgejo server listens. Distinct from
# reference-delivery (4200 / 38200) so both demos can run side by side.
BASE_URL=http://127.0.0.1:4100

# Where `temper run` binds its HTTP surface (the Forgejo webhook route plus the
# worker/wake routes). Leave WEBHOOK_URL empty to derive it from DAEMON_BIND.
DAEMON_BIND=127.0.0.1:38100
WEBHOOK_URL=

# Long role poll backstop so webhooks demonstrably drive progress; short
# mechanical cadence because Forgejo 7.0.x has no Actions-completion webhook and
# landing needs CI-read polling.
DAEMON_POLL_CADENCE_SECS=120
DAEMON_MECHANICAL_CADENCE_SECS=2
DAEMON_LEASE_TTL_SECS=300

# Hard backstop on how long the launcher blocks before tearing the run down.
RUN_SECS=600

# --- CPU cap (lesson 0009) ----------------------------------------------------
# Cap GOMAXPROCS for the spawned Forgejo server and runner (both Go programs).
# Set empty to opt out. Default 2.
TEMPER_FORGEJO_GOMAXPROCS=2

# --- Cached pinned binaries ---------------------------------------------------
# Absolute paths to Forgejo 7.0.12 and forgejo-runner 3.5.1. Leave empty for the
# shared .cache/forgejo/ paths. Ignored Forgejo fixture tests fill that cache
# automatically on first startup when network access is available.
TEMPER_FORGEJO_BINARY=
TEMPER_FORGEJO_RUNNER_BINARY=

# --- Temper entry-point binary -----------------------------------------------
# The example targets the single unified `temper` binary (it provides `temper run`
# and the `temper provision-forgejo` subcommand). Leave TEMPER_RUN_BIN empty for
# the workspace target/debug default. TEMPER_BUILD_PACKAGE is the package run.sh
# builds in the development profile unless TEMPER_SKIP_BUILD=1.
TEMPER_RUN_BIN=
TEMPER_BUILD_PACKAGE=temper

# --- Coding agent (temper run) ------------------------------------------------
# `temper run` hosts the coding agent IN-PROCESS — there is no separate worker or
# out-of-process agent binary. TEMPER_RUN_AUTH selects the LLM provider/auth
# (passed as `temper run --auth`):
#   chatgpt-oauth   (default) ChatGPT OAuth — credentials via the agent's OAuth
#                   auth file.
#   anthropic-oauth Claude OAuth.
#   deepseek        DeepSeek API key — set TEMPER_DEEPSEEK_API_KEY in secrets/.env.
# The matching provider credentials must be present in the environment for the
# chosen provider; put them in secrets/.env (gitignored). See secrets/.env.example.
TEMPER_RUN_AUTH=chatgpt-oauth

# Max agent iterations per job (temper run --max-iterations). The agent's own
# default is 250; lower it for a tighter/cheaper demo.
RUN_MAX_ITERATIONS=250
