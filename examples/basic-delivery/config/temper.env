# basic-delivery example — operator-editable configuration (NO SECRETS).
#
# This file is sourced by run.sh. It carries only knobs an operator may change;
# CLI/env overrides win over values set here. The launcher uses deterministic
# fake agents through temper-testing-worker, plus a real throwaway Forgejo and a
# real host-mode forgejo-runner. It is the minimal, single-repo, no-human-in-the-
# loop counterpart to reference-delivery: ONE repo, the three basic-delivery
# roles (architect, engineer, and the bot mechanical authority), and landing
# gated on CI alone — no reviewer, no owner, no human.

# --- Repository ---------------------------------------------------------------
# Single repo only: this example is deliberately one converging happy path. The
# launcher provisions and scans exactly OWNER/NAME (there is no REPOS set and no
# cross-repo intake).
OWNER=acme
NAME=service

# --- Workflow -----------------------------------------------------------------
# The bundled 3-role basic-delivery spec, passed to BOTH temper-provision-forgejo
# and temper-testing-worker via --workflow (Temper W1). It declares
# intake_author = site_admin (Temper W2/W3), so provisioning seeds the intake
# issue as the setup-only site admin rather than a `human` role.
#
# A relative path is taken relative to config/; an absolute path is used verbatim.
# config/workflow.json is a byte-for-byte copy of the canonical fixture
# crates/temper-workflow/fixtures/basic-delivery.json — keep the two in sync (a
# temper-testing test asserts byte equality).
WORKFLOW_FILE=workflow.json

# --- Forgejo endpoint ---------------------------------------------------------
# Where the bundled throwaway Forgejo server listens. Distinct from
# reference-delivery (4000 / 38080) so both demos can run side by side.
BASE_URL=http://127.0.0.1:4100

# --- Worker cadence / lifetime ------------------------------------------------
# Keep this long to prove webhooks are the latency accelerator for role work;
# polling remains the liveness backstop if a webhook is lost.
POLL_MS=120000

# Forgejo 7.0.x does not send webhooks when Actions jobs complete, so the
# mechanical landing worker keeps a narrow CI-status poll backstop. Leave blank
# to use POLL_MS for compatibility with the role-worker cadence.
CI_STATUS_POLL_MS=1000

# After repeated successful no-action mechanical ticks, grow the poll interval
# up to this cap. Wakes still interrupt immediately; active ticks reset to
# CI_STATUS_POLL_MS.
IDLE_POLL_MAX_MS=8000

WEBHOOKS=1
TRIGGER_BIND=127.0.0.1:38090
WEBHOOK_URL=http://127.0.0.1:38090/forgejo/webhook

# Hard backstop on how long each worker process runs before exiting on its own.
RUN_SECS=600

# --- CPU cap -----------------------------------------------------------------
# Cap GOMAXPROCS for the spawned Forgejo server and runner. Set empty to opt out.
TEMPER_FORGEJO_GOMAXPROCS=2

# --- Cached pinned binaries ---------------------------------------------------
# Absolute paths to Forgejo 7.0.12 and forgejo-runner 3.5.1. Leave empty for the
# shared .cache/forgejo/ paths. Ignored Forgejo fixture tests fill that cache
# automatically on first startup when network access is available.
TEMPER_FORGEJO_BINARY=
TEMPER_FORGEJO_RUNNER_BINARY=

# --- Temper entry-point binaries ---------------------------------------------
# The real topology uses production helpers for provisioning/webhooks and the
# testing fake-worker binary for role/mechanical behavior.
TEMPER_TESTING_WORKER_BIN=
TEMPER_PROVISION_BIN=
TEMPER_TRIGGER_BIN=
TEMPER_BUILD_PRODUCTION=temper

# --- Fake-agent behavior ------------------------------------------------------
# basic-delivery uses the `basic` fake agent set (architect + engineer only; no
# reviewer/owner/human). It is selected with `--profile basic` on the role
# workers — there is no FAKE_ARCHITECT / FAKE_REVIEWER knob (no design/breakdown
# branch and no reviewer in this workflow; triage is single-outcome).
#
# FAKE_CI_SENTINEL controls the engineer's PR-head CI marker policy:
#   present  — the first PR head carries the [ci-pass] marker, so CI passes and
#              the bot lands it (the documented happy path).
#   deferred — the first head omits the marker (CI fails), exercising the
#              engineer's address_ci_failure repair before landing.
FAKE_CI_SENTINEL=present
