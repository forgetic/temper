# Optional local overrides for the basic-delivery fake-agent example.
#
# The default demo needs no provider secrets: Forgejo role tokens are minted by
# run.sh and written to secrets/roles.env (gitignored, 0600). Copy this file to
# secrets/.env only for local machine-specific overrides that you do not want in
# config/temper.env.
#
# TEMPER_FORGEJO_BINARY=/absolute/path/to/forgejo-7.0.12-linux-amd64
# TEMPER_FORGEJO_RUNNER_BINARY=/absolute/path/to/forgejo-runner-3.5.1-linux-amd64
# TEMPER_TESTING_WORKER_BIN=/absolute/path/to/temper-testing-worker
