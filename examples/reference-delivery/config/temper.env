# reference-delivery example — operator-editable configuration (NO SECRETS).
#
# This file is sourced by run.sh. It carries only knobs an operator may change;
# CLI/env overrides win over values set here. The launcher uses deterministic
# fake agents through temper-testing-worker, plus a real throwaway Forgejo and a
# real host-mode forgejo-runner. Smith/LLM-backed examples live in the Smith
# checkout.

# --- Repository ---------------------------------------------------------------
# Legacy single-repo knobs. If REPOS is left empty, run.sh provisions and scans
# exactly OWNER/NAME:
#   REPOS= ./run.sh start
OWNER=acme
NAME=service

# Repository set for the fixed worker pool. The checked-in demo uses two repos
# so one parent intake issue can fan out into per-repo child issues.
REPOS="acme/service acme/service-canary"

# Cross-repo intake seeding. "auto" seeds one parent issue in the first repo
# when REPOS contains more than one repo, and seeds ordinary per-repo intakes in
# single-repo mode. Use 0 to demonstrate independent per-repo intakes instead.
CROSS_REPO_INTAKE=auto
CROSS_REPO_INTAKE_TITLE="Coordinate greeting across service and canary"

# --- Forgejo endpoint ---------------------------------------------------------
# Where the bundled throwaway Forgejo server listens.
BASE_URL=http://127.0.0.1:3000

# --- Worker cadence / lifetime ------------------------------------------------
# Keep this long to prove webhooks are the latency accelerator; polling remains
# the liveness backstop if a webhook is lost.
POLL_MS=120000
WEBHOOKS=1
TRIGGER_BIND=127.0.0.1:38080
WEBHOOK_URL=http://127.0.0.1:38080/forgejo/webhook

# Hard backstop on how long each worker process runs before exiting on its own.
RUN_SECS=600

# --- CPU cap -----------------------------------------------------------------
# Cap GOMAXPROCS for the spawned Forgejo server and runner. Set empty to opt out.
TEMPER_FORGEJO_GOMAXPROCS=2

# --- Cached pinned binaries ---------------------------------------------------
# Absolute paths to Forgejo 7.0.12 and forgejo-runner 3.5.1. Leave empty for the
# shared .cache/forgejo/ paths; populate them with:
#   cargo test -p temper-forgejo-fixture --test cache -- --ignored
TEMPER_FORGEJO_BINARY=
TEMPER_FORGEJO_RUNNER_BINARY=

# --- Temper entry-point binaries ---------------------------------------------
# The real topology uses production helpers for provisioning/webhooks/validation
# and the testing fake-worker binary for role/mechanical behavior.
TEMPER_TESTING_WORKER_BIN=
TEMPER_PROVISION_BIN=
TEMPER_TRIGGER_BIN=
TEMPER_VALIDATE_BIN=
TEMPER_BUILD_PRODUCTION=temper-production
TEMPER_BUILD_TESTING=temper-testing

# --- Fake-agent behavior ------------------------------------------------------
# These map to temper-testing-worker's deterministic reference-delivery fakes.
# `closing` lets merged child PRs close their produced code issues so dependency
# aggregation can unblock the cross-repo parent.
FAKE_ARCHITECT=closing
FAKE_REVIEWER=default
FAKE_CI_SENTINEL=present
