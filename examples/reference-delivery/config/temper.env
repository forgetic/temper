# reference-delivery example — operator-editable configuration (NO SECRETS).
#
# This file is sourced by run.sh. It carries only knobs an operator may change;
# CLI/env overrides win over values set here, which in turn override the binary's
# own defaults. The launcher runs a single `temper run` process (the unified
# daemon + worker + REAL in-process coding agent), plus a real throwaway Forgejo
# and a real host-mode forgejo-runner.
#
# Secrets (per-role tokens/passwords, any provider API key) never live here — see
# ../secrets/ and ../secrets/.env.example.

# --- Repository ---------------------------------------------------------------
# Single-repo knobs. If REPOS is left empty, run.sh provisions and scans exactly
# OWNER/NAME:
#   REPOS= ./run.sh start
OWNER=acme
NAME=service

# Repository set served by the single temper run process. The checked-in demo
# uses two repos so one parent intake issue can fan out into per-repo child issues.
REPOS="acme/service acme/service-canary"

# Cross-repo intake seeding. "auto" seeds one parent issue in the first repo when
# REPOS contains more than one repo, and seeds ordinary per-repo intakes in
# single-repo mode. Use 0 to demonstrate independent per-repo intakes instead.
CROSS_REPO_INTAKE=auto
CROSS_REPO_INTAKE_TITLE="Coordinate greeting across service and canary"

# --- Served roles -------------------------------------------------------------
# The workflow roles the run serves. reference-delivery adds a reviewer gate to
# basic-delivery's architect + engineer; owner and human remain workflow-declared
# but unserved by this launcher.
SERVED_ROLES="architect engineer reviewer"

# --- Workflow / intake --------------------------------------------------------
# A relative WORKFLOW_FILE / INTAKE_BODY_FILE is resolved relative to config/.
WORKFLOW_FILE=workflow.json
INTAKE_TITLE='Service banner should identify the environment'
INTAKE_BODY_FILE=intake-issue.md

# --- Forgejo + daemon endpoints ----------------------------------------------
# Where the bundled throwaway Forgejo server listens, and where `temper run` binds
# its HTTP surface (the webhook route plus worker/wake routes). Distinct from
# basic-delivery (4100 / 38100) so both demos can run side by side. Leave
# WEBHOOK_URL empty to derive it from DAEMON_BIND.
BASE_URL=http://127.0.0.1:4200
DAEMON_BIND=127.0.0.1:38200
WEBHOOK_URL=

# Long role poll backstop so webhooks demonstrably drive progress; short
# mechanical cadence because Forgejo 7.0.x has no Actions-completion webhook and
# landing needs CI-read polling.
DAEMON_POLL_CADENCE_SECS=120
DAEMON_MECHANICAL_CADENCE_SECS=2
DAEMON_LEASE_TTL_SECS=300

# Hard backstop on how long the launcher blocks before tearing the run down.
RUN_SECS=600

# --- CPU cap (lesson 0009) ----------------------------------------------------
# Cap GOMAXPROCS for the spawned Forgejo server and runner (both Go programs).
# Set empty to opt out. Default 2.
TEMPER_FORGEJO_GOMAXPROCS=2

# --- Cached pinned binaries ---------------------------------------------------
# Absolute paths to Forgejo 7.0.12 and forgejo-runner 3.5.1. Leave empty for the
# shared .cache/forgejo/ paths. Ignored Forgejo fixture tests fill that cache
# automatically on first startup when network access is available.
TEMPER_FORGEJO_BINARY=
TEMPER_FORGEJO_RUNNER_BINARY=

# --- Temper entry-point binary -----------------------------------------------
# The example targets the single unified `temper` binary: it provides `temper
# run`, the `temper provision-forgejo` subcommand, and the `temper
# validate-reference-delivery` cross-repo Forge-state validator. Leave
# TEMPER_RUN_BIN empty for the workspace target/debug default. TEMPER_BUILD_PACKAGE
# is the package run.sh builds in the development profile unless TEMPER_SKIP_BUILD=1.
TEMPER_RUN_BIN=
TEMPER_BUILD_PACKAGE=temper

# --- Coding agent (temper run) ------------------------------------------------
# `temper run` hosts the coding agent IN-PROCESS — there is no separate worker or
# out-of-process agent binary. TEMPER_RUN_AUTH selects the LLM provider/auth
# (passed as `temper run --auth`):
#   chatgpt-oauth   (default) ChatGPT OAuth — credentials via the agent's OAuth
#                   auth file.
#   anthropic-oauth Claude OAuth.
#   deepseek        DeepSeek API key — set TEMPER_DEEPSEEK_API_KEY in secrets/.env.
# Put the matching provider credentials in secrets/.env (gitignored). See
# secrets/.env.example.
TEMPER_RUN_AUTH=chatgpt-oauth

# Max agent iterations per job (temper run --max-iterations).
RUN_MAX_ITERATIONS=250
