# reference-delivery example — operator-editable configuration (NO SECRETS).
#
# This file is sourced by run.sh (added in phase B3). It carries only the knobs
# an operator may change; the launch script translates these into the
# harness-testing-worker / harness-testing-provision CLI flags. CLI overrides
# always win over what is set here, which in turn overrides the binaries' own
# defaults.
#
# Secrets (per-role tokens/passwords, any API key) never live here — see
# ../secrets/ and ../secrets/.env.example.

# --- Repository ---------------------------------------------------------------
# The org/owner and repository the example provisions and drives. These map to
# the provision binary's --owner/--name. They are the only repo identifiers an
# operator edits; role and label names are NOT set here — the workers derive
# them from config/workflow.json (the compiled workflow ∩ the role bindings).
OWNER=acme
NAME=service

# Default branch the repo is initialized with (PRs target it).
DEFAULT_BRANCH=main

# --- Forgejo endpoint ---------------------------------------------------------
# Where the bundled Forgejo server listens. The example boots its OWN throwaway
# server on the loopback interface; 127.0.0.1 with a known local port is a sane
# default. To target a real Forgejo instead, point BASE_URL at it and drop the
# bundled-server/provisioning steps (see the README "Point it at your own
# Forgejo").
BASE_URL=http://127.0.0.1:3000

# --- Worker cadence / lifetime ------------------------------------------------
# Poll interval for each worker's level-triggered loop (--poll-ms), in
# milliseconds. Lower converges faster but spends more CPU/API calls.
POLL_MS=2000

# Hard backstop on how long each worker process runs before exiting on its own
# (--run-secs). The launch script also stops workers via a stop-file sentinel;
# this is the belt-and-braces deadline. Budget several minutes for a full run.
RUN_SECS=600

# --- CPU cap (lesson 0009) ----------------------------------------------------
# The bundled Forgejo server (a Go program) can drive the host to several cores
# of sustained CPU under this multi-process workload. Cap GOMAXPROCS so the Go
# runtime cannot exceed this many cores. Set empty to opt out. Default 2.
HARNESS_FORGEJO_GOMAXPROCS=2

# --- Cached pinned binaries ---------------------------------------------------
# Absolute paths to the pinned Forgejo (7.0.12) and forgejo-runner (3.5.1)
# binaries. Leave empty to let the first run download + checksum them into
# .cache/forgejo/ (needs network to Codeberg / code.forgejo.org). On an
# offline/sandboxed host, pre-stage the binaries and point these at them.
HARNESS_FORGEJO_BINARY=
HARNESS_FORGEJO_RUNNER_BINARY=

# --- LLM agent auth (Track A) -------------------------------------------------
# Which credential the real (--agents real) LLM agents authenticate with. Maps
# to the worker's --auth flag (CLI overrides this env value).
#
#   chatgpt-oauth  (DEFAULT) — a flat ChatGPT (OpenAI Codex) subscription, no
#                  per-call cost. Reads the shared auth file below; log in once
#                  with `pi /login openai-codex`. No secret file in this repo.
#   deepseek       — pay-per-token DeepSeek API key. To switch, set this to
#                  deepseek and provide the key (see ../secrets/.env.example).
HARNESS_AGENTS_AUTH=chatgpt-oauth

# Codex model id used under chatgpt-oauth (--codex-model). Leave empty to use
# the harness-agents default (a gpt-5.x-codex id the subscription serves).
HARNESS_AGENTS_CODEX_MODEL=

# Path to the shared pi auth.json the ChatGPT OAuth bearer is read from
# (--auth-file). Leave empty to use the default (~/.pi/agent/auth.json). Both
# the nodejs and Rust pi CLIs write this file; either login works.
HARNESS_AGENTS_AUTH_FILE=
