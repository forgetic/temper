{
  "phases": [
    {
      "name": "engineer-codebase-memory",
      "when": {
        "messages_contain": [
          "ROLE: engineer"
        ]
      },
      "sequence": [
        {
          "turns": [
            {
              "tool_call": {
                "id": "graph_identify_retry_worker",
                "name": "codebase_memory_search_graph",
                "args": {
                  "query": "alias retry worker affinity"
                }
              }
            }
          ],
          "stop": "tool_calls"
        },
        {
          "turns": [
            {
              "tool_call": {
                "id": "graph_refine_retry_worker",
                "name": "codebase_memory_search_code",
                "args": {
                  "pattern": "retry_worker_topic"
                }
              }
            }
          ],
          "stop": "tool_calls"
        },
        {
          "turns": [
            {
              "tool_call": {
                "id": "read_confirmed_current_root_implementation",
                "name": "codebase_memory_get_code_snippet",
                "args": {
                  "qualified_name": "retry_worker_topic",
                  "decision_evidence_kind": "implementation"
                }
              }
            }
          ],
          "stop": "tool_calls"
        },
        {
          "turns": [
            {
              "tool_call": {
                "id": "graph_trace_retry_worker_caller",
                "name": "codebase_memory_trace_path",
                "args": {
                  "function_name": "retry_worker_topic",
                  "direction": "inbound"
                }
              }
            }
          ],
          "stop": "tool_calls"
        },
        {
          "turns": [
            {
              "tool_call": {
                "id": "read_confirmed_current_root_caller",
                "name": "codebase_memory_get_code_snippet",
                "args": {
                  "qualified_name": "dispatch",
                  "decision_evidence_kind": "caller"
                }
              }
            }
          ],
          "stop": "tool_calls"
        },
        {
          "turns": [
            {
              "tool_call": {
                "id": "read_confirmed_current_root_test",
                "name": "codebase_memory_get_code_snippet",
                "args": {
                  "qualified_name": "alias_retries_keep_the_original_ordered_worker",
                  "decision_evidence_kind": "focused_test"
                }
              }
            }
          ],
          "stop": "tool_calls"
        },
        {
          "turns": [
            {
              "tool_call": {
                "id": "create_memory_notes",
                "name": "apply_patch",
                "args": {
                  "patch": "diff --git a/demo/MEMORY_NOTES.md b/demo/MEMORY_NOTES.md\nnew file mode 100644\n--- /dev/null\n+++ b/demo/MEMORY_NOTES.md\n@@ -0,0 +1,4 @@\n+memory-guided notes\n+src/lib.rs: retry_worker_topic chooses the ordered worker key for an event attempt.\n+src/caller.rs: dispatch calls retry_worker_topic.\n+tests/retry_affinity.rs: alias_retries_keep_the_original_ordered_worker checks retry affinity.\n"
                }
              }
            }
          ],
          "stop": "tool_calls"
        },
        {
          "turns": [
            {
              "tool_call": {
                "id": "call_submit_memory_notes",
                "name": "submit_for_pr",
                "args": {
                  "summary": "Used codebase memory search result before writing MEMORY_NOTES.md."
                }
              }
            }
          ],
          "stop": "tool_calls"
        },
        {
          "text": "{\"title\":\"Use codebase memory result\",\"body\":\"# Implementation report\\nWrote MEMORY_NOTES.md from the fake codebase-memory search result.\",\"summary\":\"Used codebase memory search result before writing MEMORY_NOTES.md.\"}"
        }
      ]
    }
  ]
}
