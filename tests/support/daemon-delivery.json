{
  "name": "basic-delivery",
  "intake_author": { "kind": "site_admin" },
  "roles": [
    {
      "id": "engineer",
      "charter": "Claim ready code issues, implement them, open PRs, and address failed CI gates before landing.",
      "prompt": {
        "guidance": "Use open_pr for ready code: the coding workspace must produce a real product diff and the engine opens a PR from the head it produces. Use address_ci_failure for PRs whose CI failed before landing."
      },
      "external_tools": [
        {
          "id": "coding_workspace",
          "description": "Prepare a checked-out repository workspace, make or delegate code edits, commit a PR head branch, and report changed files plus a short summary.",
          "required": false,
          "constraints": [
            "Only touch the checked-out repository workspace.",
            "Do not create bookkeeping-only diffs such as .temper-pr-prep or .temper-ci changes."
          ],
          "guidance": "Use this for open_pr on ready code issues. If it is not bound, fail the assigned implementation job with a structured unavailable-workspace result."
        }
      ],
      "concurrency": 1,
      "queues": [
        "code_ready",
        "pr_ci_failed"
      ]
    },
    {
      "id": "mechanical",
      "charter": "Automation authority used by the mechanical worker to stamp raw intake ready for the engineer and to land CI-green PRs; do not bind this role to an LLM worker.",
      "prompt": {
        "guidance": "Automation-only role id for queue automation authorization. It is serviced by the mechanical worker, not by a role worker."
      },
      "concurrency": 1,
      "queues": []
    }
  ],
  "labels": [
    {
      "id": "code",
      "description": "identifies a code issue"
    },
    {
      "id": "ready",
      "description": "work item is ready for the next workflow step"
    },
    {
      "id": "in-progress",
      "description": "work item is currently being advanced"
    },
    {
      "id": "implementation",
      "description": "identifies an implementation pull request"
    },
    {
      "id": "landed",
      "description": "merged PR"
    }
  ],
  "artifact_kinds": [
    {
      "id": "intake",
      "target": "issue",
      "identifying_labels": []
    },
    {
      "id": "code",
      "target": "issue",
      "identifying_labels": [
        "code"
      ]
    },
    {
      "id": "implementation_pr",
      "target": "pull_request",
      "identifying_labels": [
        "implementation"
      ]
    }
  ],
  "relations": [
    {
      "kind": "produced_pr",
      "source": "implementation_pr",
      "target": "code"
    }
  ],
  "state_dimensions": [
    {
      "id": "work_lifecycle",
      "exclusive": true,
      "states": [
        {
          "id": "ready",
          "label": "ready",
          "artifacts": [
            "code"
          ]
        },
        {
          "id": "in_progress",
          "label": "in-progress",
          "artifacts": [
            "code"
          ]
        }
      ]
    },
    {
      "id": "post_merge",
      "exclusive": false,
      "states": [
        {
          "id": "landed",
          "label": "landed"
        }
      ]
    }
  ],
  "queues": [
    {
      "id": "raw_intake",
      "artifact": "intake",
      "automation": {
        "actor": "mechanical",
        "transition": "mark_ready"
      }
    },
    {
      "id": "code_ready",
      "artifact": "code",
      "labels": [
        "ready"
      ],
      "actions": [
        {
          "role": "engineer",
          "action": "open_pr"
        }
      ]
    },
    {
      "id": "pr_ci_failed",
      "artifact": "implementation_pr",
      "condition": {
        "kind": "ci_failed"
      },
      "actions": [
        {
          "role": "engineer",
          "action": "address_ci_failure",
          "checkout": "pull_request_writable"
        }
      ]
    },
    {
      "id": "landing",
      "artifact": "implementation_pr",
      "labels": [
        "implementation"
      ],
      "condition": {
        "kind": "ci_passed"
      },
      "automation": {
        "actor": "mechanical",
        "transition": "land_pr"
      }
    }
  ],
  "transitions": [
    {
      "id": "mark_ready",
      "artifact": "intake",
      "roles": [
        "mechanical"
      ],
      "effects": [
        {
          "kind": "add_label",
          "label": "code"
        },
        {
          "kind": "add_label",
          "label": "ready"
        }
      ]
    },
    {
      "id": "open_pr",
      "artifact": "code",
      "roles": [
        "engineer"
      ],
      "effects": [
        {
          "kind": "remove_label",
          "label": "ready"
        },
        {
          "kind": "add_label",
          "label": "in-progress"
        },
        {
          "kind": "set_assignee",
          "role": "engineer"
        },
        {
          "kind": "create_pull_request"
        }
      ]
    },
    {
      "id": "address_ci_failure",
      "artifact": "implementation_pr",
      "roles": [
        "engineer"
      ],
      "effects": []
    },
    {
      "id": "land_pr",
      "artifact": "implementation_pr",
      "roles": [
        "mechanical"
      ],
      "requires_gates": [
        "ci_gate"
      ],
      "effects": [
        {
          "kind": "merge_pull_request"
        },
        {
          "kind": "add_label",
          "label": "landed"
        }
      ]
    }
  ],
  "gates": [
    {
      "id": "ci_gate",
      "condition": {
        "kind": "ci_passed"
      }
    }
  ]
}
