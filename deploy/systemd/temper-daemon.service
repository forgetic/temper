# Repo-tracked template for the temper engine-service systemd user unit.
#
# The engine is the sole Forgejo API writer in the two-tier topology: webhook
# intake, poll backstop, scan-to-enqueue dispatch to long-polling workers,
# lease-gated role-attributed applies, and the optional mechanical backstop all
# run here. Workers connect to the engine's bind address and never touch the
# Forge API.
#
# Install with deploy/install.sh, then adjust %h/.config/temper/config.toml
# (run `temper config validate`). Forgejo API tokens load from the provisioned
# roles.env file; this template and config.toml contain no secrets.

[Unit]
Description=Temper engine service
After=forgejo.service network-online.target
Wants=network-online.target

# Type=simple: the daemon is considered started as soon as it is forked; it
# signals readiness via a log line (see deploy/README.md). TODO: switch to
# Type=notify once the daemon calls sd_notify(READY=1) after binding, so
# systemd tracks readiness precisely and ordered dependents can wait on it.
[Service]
Type=simple
# Optional operator env overrides (e.g. TEMPER_CONFIG, RUST_LOG); the secrets
# file is required. The `-` prefix makes the first file optional.
EnvironmentFile=-%h/.config/temper/daemon.env
EnvironmentFile=%h/.config/temper/secrets/roles.env
# Log level knob. RUST_LOG is the single control for verbosity; operators
# override it (e.g. RUST_LOG=debug) in the optional %h/.config/temper/daemon.env
# drop-in above without editing this unit.
Environment=RUST_LOG=info
ExecStart=%h/.local/bin/temper-daemon-launcher
Restart=on-failure
RestartSec=5
# Route stdout/stderr to the journal. These are the systemd defaults, set
# explicitly here so JOURNAL_STREAM is always present in the daemon's
# environment: the env-aware tracing init detects it and emits structured
# entries through tracing-journald (native journal priorities, no ANSI),
# instead of plain colored stderr. Inspect with `journalctl -u temper-daemon`.
StandardOutput=journal
StandardError=journal
# Tag journal entries so they are cleanly attributable
# (e.g. `journalctl SYSLOG_IDENTIFIER=temper-daemon`).
SyslogIdentifier=temper-daemon

[Install]
WantedBy=default.target
