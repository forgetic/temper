#!/bin/sh
# temper-daemon-launcher — systemd ExecStart shim for the temper engine service.
#
# Maps the provisioned roles.env bot identity onto the generic FORGEJO_* names
# the config resolver reads (env overrides the config file), then runs the
# config-driven engine. Per-role TEMPER_FORGEJO_TOKEN_<ROLE> vars pass through
# untouched (the resolver reads them for role-attributed applies). Deployment
# settings (repos, roles, cadences, bind) live in the config file, not here.
set -eu

[ -n "${TEMPER_FORGEJO_BOT_TOKEN:-}" ] || {
    echo 'temper-daemon-launcher: no TEMPER_FORGEJO_BOT_TOKEN in the environment; is ~/.config/temper/secrets/roles.env provisioned?' >&2
    exit 1
}
export FORGEJO_ACCESS_TOKEN="$TEMPER_FORGEJO_BOT_TOKEN"
# Optional web-UI credentials for the ADR 0019 CI-read fallback used by the
# mechanical backstop; both must be present to take effect.
if [ -n "${TEMPER_FORGEJO_BOT_USER:-}" ] && [ -n "${TEMPER_FORGEJO_BOT_PASSWORD:-}" ]; then
    export FORGEJO_USERNAME="$TEMPER_FORGEJO_BOT_USER"
    export FORGEJO_PASSWORD="$TEMPER_FORGEJO_BOT_PASSWORD"
fi

config="${TEMPER_CONFIG:-$HOME/.config/temper/config.toml}"
exec "$HOME/.local/bin/temper" daemon --service engine --config "$config" "$@"
