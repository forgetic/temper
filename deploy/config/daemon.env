# temper-daemon environment template.
#
# Installed to ~/.config/temper/daemon.env by deploy/install.sh if that file is
# absent. This file uses systemd EnvironmentFile syntax: plain KEY=VALUE lines,
# no shell expansion, and no secrets. Keep Forgejo tokens/passwords in
# ~/.config/temper/secrets/roles.env.

# Forgejo base URL used by ForgejoConfig::from_env via the launcher.
BASE_URL=http://127.0.0.1:3000

# Address and port for the daemon HTTP API. smith-worker processes long-poll
# this endpoint for work.
DAEMON_BIND=127.0.0.1:8080

# Stable identity stamped on leases held by this daemon instance.
DAEMON_ID=temper-daemon-1

# Space-separated owner/name repositories scanned by the webhook and poll
# backstops.
DAEMON_REPOS=ai/temper ai/smith

# Space-separated workflow role ids exposed to long-polling workers.
DAEMON_ROLES=engineer

# Poll-backstop cadence in seconds. This is the LEVEL-TRIGGERED liveness
# backstop (ADR 0009): webhooks are the low-latency accelerator, so this only
# needs to be frequent enough to recover from a missed/dropped webhook. Keep it
# slow to stay idle-quiet — webhooks drive prompt reaction, this is the safety
# net. (Was 30s; raised to cut idle Forgejo load.)
DAEMON_POLL_CADENCE_SECS=120

# Mechanical backstop cadence in seconds. Same level-triggered role as the poll
# backstop: each verified webhook delivery runs an immediate hinted mechanical
# pass for the affected repo, so this cadence is the idle safety net, not the
# primary reaction path. A full pass re-reads every gated PR's CI, so a tight
# cadence is the dominant idle cost — keep it slow. Leave empty or remove this
# key to disable the mechanical backstop entirely. (Was 10s.)
DAEMON_MECHANICAL_CADENCE_SECS=300

# Lease time-to-live in seconds for daemon-gated applies.
DAEMON_LEASE_TTL_SECS=300

# Optional absolute path to the webhook shared-secret file. Empty or unset
# disables the webhook route. systemd EnvironmentFile does not expand %h or
# $HOME here; use a full path such as
# /home/temper/.config/temper/secrets/webhook-secret.
DAEMON_WEBHOOK_SECRET_FILE=
