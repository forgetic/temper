+
+            node_ref.linked.set(false);
+            node_ref.prev.set(None);
+            node_ref.next.set(None);
+
             if node_ref.deadline() <= now {
                 if let Some(waker) = node_ref.take_waker() {
                     wakers.push(waker);
                 }
                 self.count = self.count.saturating_sub(1);
-                continue;
