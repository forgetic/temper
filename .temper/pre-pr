#!/usr/bin/env sh
set -eu

script_dir=$(dirname "$0")
repo_root=$(cd "$script_dir/.." && pwd)
cd "$repo_root"

if [ -z "${TMPDIR:-}" ]; then
    TMPDIR="/tmp/tp$(id -u)"
fi
mkdir -p "$TMPDIR"
export TMPDIR

run() {
    printf '\n==> %s\n' "$*"
    "$@"
}

free_linked_test_binaries() {
    target_debug_dir="${CARGO_TARGET_DIR:-target}/debug"
    target_deps_dir="$target_debug_dir/deps"

    if [ ! -d "$target_debug_dir" ]; then
        return 0
    fi

    if [ -d "$target_deps_dir" ]; then
        run find "$target_debug_dir" "$target_deps_dir" -maxdepth 1 -type f -perm -111 ! -name '*.so' -delete
    else
        run find "$target_debug_dir" -maxdepth 1 -type f -perm -111 ! -name '*.so' -delete
    fi
}

# Some remote build caches restore custom harness artifacts without their Unix
# execute bit. Cargo considers the artifact fresh, so normalize the two
# early-main containment harnesses before nextest tries to enumerate them.
ensure_custom_harnesses_executable() {
    target_deps_dir="${CARGO_TARGET_DIR:-target}/debug/deps"
    if [ -d "$target_deps_dir" ]; then
        run find "$target_deps_dir" -maxdepth 1 -type f \
            \( -name 'linux_supervisor-*' -o -name 'windows_job-*' \) \
            ! -name '*.d' -exec chmod +x {} +
    fi
}

run cargo fmt --all -- --check
run cargo depgraph-check check
run scripts/check-rust-file-size.sh
run scripts/check-no-ambient-env.sh
run cargo dev-test-build
ensure_custom_harnesses_executable
run cargo dev-test-quick
free_linked_test_binaries
run cargo dev-clippy
