{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://temper.local/reference/worker-daemon-wire-protocol/schema.json",
 "title": "Worker/Daemon Wire Protocol v1",
 "type": "object",
 "oneOf": [
  {
   "$ref": "#/$defs/register"
  },
  {
   "$ref": "#/$defs/poll"
  },
  {
   "$ref": "#/$defs/assign"
  },
  {
   "$ref": "#/$defs/heartbeat"
  },
  {
   "$ref": "#/$defs/cancelAttempts"
  },
  {
   "$ref": "#/$defs/result"
  },
  {
   "$ref": "#/$defs/release"
  },
  {
   "$ref": "#/$defs/leaseAck"
  },
  {
   "$ref": "#/$defs/fetchContext"
  },
  {
   "$ref": "#/$defs/contextResponse"
  },
  {
   "$ref": "#/$defs/activityBatch"
  },
  {
   "$ref": "#/$defs/activityAck"
  },
  {
   "$ref": "#/$defs/error"
  }
 ],
 "$defs": {
  "traceContext": {
   "type": "object",
   "required": [
    "traceparent"
   ],
   "properties": {
    "traceparent": {
     "type": "string",
     "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "tracestate": {
     "type": "string",
     "minLength": 1,
     "maxLength": 512,
     "pattern": "^[ -~]+$"
    }
   },
   "additionalProperties": false
  },
  "capability": {
   "type": "object",
   "required": [
    "role",
    "repo"
   ],
   "properties": {
    "role": {
     "type": "string",
     "minLength": 1
    },
    "repo": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "register": {
   "type": "object",
   "required": [
    "protocol_version",
    "type",
    "worker_id",
    "capabilities",
    "capacity"
   ],
   "properties": {
    "protocol_version": {
     "const": 1
    },
    "type": {
     "const": "register"
    },
    "worker_id": {
     "type": "string",
     "minLength": 1
    },
    "worker_pool": {
     "type": "string",
     "minLength": 1
    },
    "capabilities": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/capability"
     }
    },
    "capacity": {
     "type": "object",
     "required": [
      "max_concurrent_jobs"
     ],
     "properties": {
      "max_concurrent_jobs": {
       "type": "integer",
       "minimum": 1
      }
     }
    },
    "labels": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "poll": {
   "type": "object",
   "required": [
    "protocol_version",
    "type",
    "worker_id",
    "free_capacity"
   ],
   "properties": {
    "protocol_version": {
     "const": 1
    },
    "type": {
     "const": "poll"
    },
    "worker_id": {
     "type": "string",
     "minLength": 1
    },
    "free_capacity": {
     "type": "integer",
     "minimum": 0
    },
    "max_wait_ms": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "assign": {
   "type": "object",
   "required": [
    "protocol_version",
    "type",
    "job_id",
    "attempt_id",
    "role",
    "repo",
    "artifact",
    "job_payload"
   ],
   "properties": {
    "protocol_version": {
     "const": 1
    },
    "type": {
     "const": "assign"
    },
    "trace_context": {
     "$ref": "#/$defs/traceContext"
    },
    "job_id": {
     "type": "string",
     "minLength": 1
    },
    "attempt_id": {
     "type": "string",
     "minLength": 1
    },
    "role": {
     "type": "string",
     "minLength": 1
    },
    "repo": {
     "type": "string",
     "minLength": 1
    },
    "artifact": {
     "type": "object",
     "required": [
      "item",
      "kind"
     ],
     "properties": {
      "item": {
       "type": [
        "string",
        "number"
       ]
      },
      "kind": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "job_payload": {
     "type": "object",
     "properties": {
      "trace_context": {
       "$ref": "#/$defs/traceContext"
      },
      "role": {
       "type": "string",
       "minLength": 1
      },
      "repo": {
       "type": "string",
       "minLength": 1
      },
      "queue": {
       "type": "string",
       "minLength": 1
      },
      "artifact_kind": {
       "type": "string",
       "minLength": 1
      },
      "repository": {
       "type": "object",
       "required": [
        "owner",
        "name",
        "default_branch"
       ],
       "properties": {
        "owner": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "default_branch": {
         "type": "string"
        }
       }
      },
      "base_branch": {
       "type": "string"
      },
      "branch_hint": {
       "type": "string"
      },
      "correlation_key": {
       "type": "string"
      },
      "artifact": {
       "type": "object",
       "required": [
        "number",
        "title",
        "body",
        "labels",
        "state"
       ],
       "properties": {
        "number": {
         "type": "integer",
         "minimum": 1
        },
        "title": {
         "type": "string"
        },
        "body": {
         "type": "string"
        },
        "labels": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "state": {
         "type": "string"
        }
       }
      },
      "artifact_context": {
       "$ref": "#/$defs/artifactContextBundle"
      },
      "action": {
       "type": "string"
      },
      "checkout_capability": {
       "enum": [
        "writable",
        "read_only",
        "pull_request_read_only",
        "pull_request_writable"
       ]
      },
      "allowed_verdicts": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "verdict_contracts": {
       "type": "object",
       "additionalProperties": {
        "$ref": "#/$defs/verdictContract"
       }
      },
      "source_metadata": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "heartbeatJob": {
   "type": "object",
   "required": [
    "job_id",
    "attempt_id",
    "state",
    "message"
   ],
   "properties": {
    "job_id": {
     "type": "string",
     "minLength": 1
    },
    "attempt_id": {
     "type": "string",
     "minLength": 1
    },
    "state": {
     "enum": [
      "running",
      "waiting",
      "finishing"
     ]
    },
    "message": {
     "type": "string"
    },
    "liveness": {
     "$ref": "#/$defs/jobLiveness"
    }
   }
  },
  "jobLiveness": {
   "type": "object",
   "required": [
    "phase",
    "run_elapsed_ms",
    "no_progress_elapsed_ms",
    "active_operation_count",
    "cancellation",
    "result_durability",
    "result_delivery",
    "pending_result"
   ],
   "properties": {
    "phase": {
     "enum": ["running", "cancel_requested", "quiesced", "result_recorded"]
    },
    "run_elapsed_ms": { "type": "integer", "minimum": 0 },
    "no_progress_elapsed_ms": { "type": "integer", "minimum": 0 },
    "active_operation_count": { "type": "integer", "minimum": 0 },
    "active_operations": {
     "type": "array",
     "maxItems": 8,
     "items": { "$ref": "#/$defs/jobOperationSummary" }
    },
    "timeout": { "$ref": "#/$defs/jobTimeoutSummary" },
    "cancellation": {
     "enum": ["not_requested", "requested", "escalated", "quiesced"]
    },
    "result_durability": { "enum": ["none", "pending", "durable"] },
    "result_delivery": { "enum": ["not_ready", "pending"] },
    "pending_result": { "type": "boolean" }
   }
  },
  "jobOperationSummary": {
   "type": "object",
   "required": ["scope", "kind", "name", "operation_id", "elapsed_ms"],
   "properties": {
    "scope": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["model", "tool"] },
    "name": { "type": "string", "minLength": 1 },
    "operation_id": { "type": "string", "minLength": 1 },
    "elapsed_ms": { "type": "integer", "minimum": 0 }
   },
   "additionalProperties": false
  },
  "jobTimeoutSummary": {
   "type": "object",
   "required": ["reason", "limit_ms"],
   "properties": {
    "reason": { "enum": ["no_progress", "max_run"] },
    "limit_ms": { "type": "integer", "minimum": 1 }
   },
   "additionalProperties": false
  },
  "verdictContract": {
   "type": "object",
   "properties": {
    "min_children": { "type": "integer", "minimum": 0 },
    "max_children": { "type": "integer", "minimum": 0 },
    "allowed_child_kinds": {
     "type": "array",
     "items": { "type": "string" }
    },
    "required_child_metadata": {
     "type": "array",
     "items": { "type": "string" }
    },
    "requires_pr_title": { "type": "boolean" },
    "requires_pr_body": { "type": "boolean" },
    "requires_body": { "type": "boolean" },
    "required_source_metadata": {
     "type": "array",
     "items": { "type": "string" }
    }
   }
  },
  "jobChild": {
   "type": "object",
   "required": [
    "slug",
    "title",
    "body"
   ],
   "properties": {
    "slug": {
     "type": "string",
     "minLength": 1
    },
    "title": {
     "type": "string"
    },
    "body": {
     "type": "string"
    },
    "kind": {
     "type": "string",
     "minLength": 1
    },
    "labels": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "depends_on": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "target_repo": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "artifactContextBundle": {
   "type": "object",
   "required": ["version", "repository", "artifact_type", "primary", "truncation"],
   "properties": {
    "version": { "const": 1 },
    "repository": { "$ref": "#/$defs/artifactRepository" },
    "artifact_type": { "enum": ["issue", "pull_request"] },
    "primary": { "$ref": "#/$defs/artifactSnapshot" },
    "lineage": { "type": "array", "items": { "$ref": "#/$defs/artifactSnapshot" } },
    "validation_scope": { "type": "array", "items": { "$ref": "#/$defs/artifactSummary" } },
    "optional_references": { "type": "array", "items": { "$ref": "#/$defs/artifactSummary" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/artifactDiagnostic" } },
    "truncation": { "$ref": "#/$defs/contextTruncation" }
   }
  },
  "artifactRepository": {
   "type": "object",
   "required": ["id", "path"],
   "properties": {
    "id": { "type": "string" },
    "path": { "type": "string", "minLength": 1 }
   }
  },
  "artifactReference": {
   "type": "object",
   "required": ["repository", "artifact_type", "number"],
   "properties": {
    "repository": { "$ref": "#/$defs/artifactRepository" },
    "artifact_type": { "enum": ["issue", "pull_request"] },
    "number": { "type": "integer", "minimum": 1 }
   }
  },
  "artifactSnapshot": {
   "type": "object",
   "required": ["artifact", "title", "body", "state"],
   "properties": {
    "artifact": { "$ref": "#/$defs/artifactReference" },
    "title": { "type": "string" },
    "body": { "type": "string" },
    "labels": { "type": "array", "items": { "type": "string" } },
    "state": { "type": "string" },
    "workflow_kind": { "type": "string", "minLength": 1 },
    "workflow": { "$ref": "#/$defs/artifactWorkflowContext" }
   }
  },
  "artifactWorkflowContext": {
   "type": "object",
   "properties": {
    "kind": { "type": "string", "minLength": 1 },
    "parents": {
     "type": "array",
     "items": { "$ref": "#/$defs/workflowArtifactReference" }
    },
    "dependencies": {
     "type": "array",
     "items": { "$ref": "#/$defs/workflowArtifactReference" }
    },
    "target_branch": { "type": "string", "minLength": 1 },
    "correlation_key": { "type": "string", "minLength": 1 },
    "children": {
     "type": "array",
     "items": { "$ref": "#/$defs/workflowChildIdentity" }
    }
   },
   "additionalProperties": false
  },
  "workflowArtifactReference": {
   "type": "object",
   "required": ["repository_id", "number"],
   "properties": {
    "repository_id": { "type": "string", "minLength": 1 },
    "number": { "type": "integer", "minimum": 1 }
   },
   "additionalProperties": false
  },
  "workflowChildIdentity": {
   "type": "object",
   "required": ["repository_id", "number", "title"],
   "properties": {
    "repository_id": { "type": "string", "minLength": 1 },
    "number": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "state": { "type": "string" }
   },
   "additionalProperties": false
  },
  "artifactSummary": {
   "type": "object",
   "required": ["artifact", "title", "state", "relation_type", "source"],
   "properties": {
    "artifact": { "$ref": "#/$defs/artifactReference" },
    "title": { "type": "string" },
    "labels": { "type": "array", "items": { "type": "string" } },
    "state": { "type": "string" },
    "workflow_kind": { "type": "string", "minLength": 1 },
    "relation_type": { "enum": ["parent", "dependency", "related"] },
    "source": { "$ref": "#/$defs/artifactReference" }
   }
  },
  "artifactIndexEntry": {
   "type": "object",
   "required": ["artifact", "title", "state"],
   "properties": {
    "artifact": { "$ref": "#/$defs/artifactReference" },
    "title": { "type": "string" },
    "state": { "type": "string" },
    "snapshot_index": { "type": "integer", "minimum": 0 }
   }
  },
  "contextTruncation": {
   "type": "object",
   "required": ["depth_exceeded", "count_exceeded", "content_truncated"],
   "properties": {
    "depth_exceeded": { "type": "boolean" },
    "count_exceeded": { "type": "boolean" },
    "content_truncated": { "type": "boolean" }
   }
  },
  "artifactRelation": {
   "type": "object",
   "required": ["relation_type", "source", "target"],
   "properties": {
    "relation_type": { "enum": ["parent", "dependency", "related"] },
    "source": { "$ref": "#/$defs/artifactReference" },
    "target": { "$ref": "#/$defs/artifactReference" }
   }
  },
  "artifactDiagnostic": {
   "type": "object",
   "required": ["code", "message"],
   "properties": {
    "code": { "enum": ["missing_artifact", "closed_ancestor", "malformed_metadata", "repository_not_allowed", "cycle_detected", "depth_exceeded", "count_exceeded", "content_truncated", "forge_read_failed"] },
    "message": { "type": "string" },
    "source": { "$ref": "#/$defs/artifactReference" }
   }
  },
  "forgeItemComment": {
   "type": "object",
   "required": ["id", "author_id", "body", "created_at", "updated_at"],
   "properties": {
    "id": { "type": "string" },
    "author_id": { "type": "string" },
    "body": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
   }
  },
  "forgeRelatedEdge": {
   "type": "object",
   "required": ["relation", "source", "target"],
   "properties": {
    "relation": { "enum": ["parent", "child", "dependency", "dependent", "produced_pr", "body_reference", "referenced_by"] },
    "source": { "$ref": "#/$defs/artifactReference" },
    "target": { "$ref": "#/$defs/artifactReference" }
   }
  },
  "forgeContextOperation": {
   "oneOf": [
    {
     "type": "object",
     "required": ["operation", "repo", "number"],
     "properties": {
      "operation": { "const": "forge_get_item" },
      "repo": { "type": "string", "minLength": 1 },
      "number": { "type": "integer", "minimum": 1 },
      "type": { "enum": ["issue", "pull_request"] },
      "include_comments": { "type": "boolean" }
     }
    },
    {
     "type": "object",
     "required": ["operation", "repo", "number", "relations"],
     "properties": {
      "operation": { "const": "forge_list_related" },
      "repo": { "type": "string", "minLength": 1 },
      "number": { "type": "integer", "minimum": 1 },
      "type": { "enum": ["issue", "pull_request"] },
      "relations": {
       "type": "array",
       "minItems": 1,
       "uniqueItems": true,
       "items": { "enum": ["parent", "child", "dependency", "dependent", "produced_pr", "body_reference", "referenced_by"] }
      },
      "depth": { "type": "integer", "minimum": 1, "maximum": 2 },
      "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
     }
    }
   ]
  },
  "fetchContext": {
   "type": "object",
   "required": ["protocol_version", "type", "worker_id", "job_id", "attempt_id", "operation"],
   "properties": {
    "protocol_version": { "const": 1 },
    "type": { "const": "fetch-context" },
    "worker_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "job_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "operation": { "$ref": "#/$defs/forgeContextOperation" }
   }
  },
  "contextResponse": {
   "type": "object",
   "required": ["protocol_version", "type", "worker_id", "job_id", "status"],
   "properties": {
    "protocol_version": { "const": 1 },
    "type": { "const": "context-response" },
    "worker_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["success", "error"] },
    "result": {
     "oneOf": [
      {
       "type": "object",
       "required": ["result", "item", "truncation"],
       "properties": {
        "result": { "const": "item" },
        "item": { "$ref": "#/$defs/artifactSnapshot" },
        "comments": { "type": "array", "items": { "$ref": "#/$defs/forgeItemComment" } },
        "truncation": { "$ref": "#/$defs/contextTruncation" }
       }
      },
      {
       "type": "object",
       "required": ["result", "root", "truncation"],
       "properties": {
        "result": { "const": "related" },
        "root": { "$ref": "#/$defs/artifactReference" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/artifactIndexEntry" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/forgeRelatedEdge" } },
        "truncation": { "$ref": "#/$defs/contextTruncation" }
       }
      }
     ]
    },
    "code": { "enum": ["invalid_request", "not_authorized", "not_found", "forge_unavailable", "limit_exceeded"] }
   },
   "allOf": [
    { "if": { "properties": { "status": { "const": "success" } } }, "then": { "required": ["result"] } },
    { "if": { "properties": { "status": { "const": "error" } } }, "then": { "required": ["code"] } }
   ]
  },
  "activityCapturePolicy": {
   "type": "object",
   "required": ["version", "capture", "retention_days", "max_run_bytes", "max_inline_bytes", "max_blob_bytes", "capture_thinking"],
   "properties": {
    "version": { "const": 1 },
    "capture": { "enum": ["off", "metadata", "transcript", "diagnostic"] },
    "retention_days": { "type": "integer", "minimum": 1 },
    "max_run_bytes": { "type": "integer", "minimum": 1 },
    "max_inline_bytes": { "type": "integer", "minimum": 1 },
    "max_blob_bytes": { "type": "integer", "minimum": 1 },
    "capture_thinking": { "type": "boolean" }
   }
  },
  "activityBatch": {
   "type": "object",
   "required": ["protocol_version", "type", "worker_id", "assignment_id", "capture_policy", "batch"],
   "properties": {
    "protocol_version": { "const": 1 },
    "type": { "const": "activity-batch" },
    "worker_id": { "type": "string", "minLength": 1 },
    "assignment_id": { "type": "string", "minLength": 1 },
    "capture_policy": { "$ref": "#/$defs/activityCapturePolicy" },
    "batch": {
     "type": "object",
     "required": ["version", "run_id", "first_seq", "events"],
     "properties": {
      "version": { "const": 1 },
      "run_id": { "type": "string", "minLength": 1 },
      "first_seq": { "type": "integer", "minimum": 1 },
      "events": { "type": "array", "minItems": 1, "items": { "type": "object" } },
      "blobs": { "type": "array", "items": { "type": "object" } }
     }
    }
   }
  },
  "activityAck": {
   "type": "object",
   "required": ["protocol_version", "type", "worker_id", "acknowledgement"],
   "properties": {
    "protocol_version": { "const": 1 },
    "type": { "const": "activity-ack" },
    "worker_id": { "type": "string", "minLength": 1 },
    "acknowledgement": {
     "type": "object",
     "required": ["version", "run_id", "highest_contiguous_seq"],
     "properties": {
      "version": { "const": 1 },
      "run_id": { "type": "string", "minLength": 1 },
      "highest_contiguous_seq": { "type": "integer", "minimum": 0 }
     }
    }
   }
  },
  "heartbeat": {
   "type": "object",
   "required": [
    "protocol_version",
    "type",
    "worker_id",
    "jobs"
   ],
   "properties": {
    "protocol_version": {
     "const": 1
    },
    "type": {
     "const": "heartbeat"
    },
    "worker_id": {
     "type": "string",
     "minLength": 1
    },
    "jobs": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/heartbeatJob"
     }
    },
    "free_capacity": {
     "type": "integer",
     "minimum": 0
    },
    "worker_pool": {
     "type": "string",
     "minLength": 1
    },
    "max_concurrent_jobs": {
     "type": "integer",
     "minimum": 1
    },
    "capabilities": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/capability"
     }
    }
   }
  },
  "cancelAttempts": {
   "type": "object",
   "required": ["protocol_version", "type", "worker_id", "cancellations"],
   "properties": {
    "protocol_version": { "const": 1 },
    "type": { "const": "cancel-attempts" },
    "worker_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "cancellations": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": ["worker_id", "job_id", "attempt_id", "cause", "reason"],
      "properties": {
       "worker_id": { "type": "string", "minLength": 1, "maxLength": 256 },
       "job_id": { "type": "string", "minLength": 1, "maxLength": 256 },
       "attempt_id": { "type": "string", "minLength": 1, "maxLength": 256 },
       "cause": { "const": "ownership_lost" },
       "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
     }
    }
   }
  },
  "result": {
   "type": "object",
   "required": [
    "protocol_version",
    "type",
    "worker_id",
    "job_id",
    "attempt_id",
    "status"
   ],
   "properties": {
    "protocol_version": {
     "const": 1
    },
    "type": {
     "const": "result"
    },
    "worker_id": {
     "type": "string",
     "minLength": 1
    },
    "job_id": {
     "type": "string",
     "minLength": 1
    },
    "attempt_id": {
     "type": "string",
     "minLength": 1
    },
    "status": {
     "enum": [
      "success",
      "failure"
     ]
    },
    "branch": {
     "type": "object",
     "required": [
      "name",
      "head_sha"
     ],
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "head_sha": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "verdict": {
     "type": "string"
    },
    "body": {
     "type": "string"
    },
    "children": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/jobChild"
     }
    },
    "failure": {
     "type": "object",
     "required": [
      "class",
      "message"
     ],
     "properties": {
      "class": {
       "enum": [
        "transient",
        "permanent",
        "canceled",
        "protocol"
       ]
      },
      "message": {
       "type": "string"
      }
     }
    },
    "summary": {
     "type": "string"
    },
    "details": {
     "type": "object"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "status": {
        "const": "failure"
       }
      },
      "required": [
       "status"
      ]
     },
     "then": {
      "required": [
       "failure"
      ]
     }
    }
   ]
  },
  "release": {
   "type": "object",
   "required": [
    "protocol_version",
    "type",
    "worker_id",
    "job_id",
    "attempt_id",
    "disposition"
   ],
   "properties": {
    "protocol_version": {
     "const": 1
    },
    "type": {
     "const": "release"
    },
    "worker_id": {
     "type": "string",
     "minLength": 1
    },
    "job_id": {
     "type": "string",
     "minLength": 1
    },
    "attempt_id": {
     "type": "string",
     "minLength": 1
    },
    "disposition": {
     "enum": [
      "accepted",
      "superseded",
      "reclaimed"
     ]
    },
    "message": {
     "type": "string"
    }
   }
  },
  "leaseAck": {
   "type": "object",
   "required": [
    "protocol_version",
    "type",
    "worker_id",
    "job_id",
    "disposition"
   ],
   "properties": {
    "protocol_version": {
     "const": 1
    },
    "type": {
     "const": "lease-ack"
    },
    "worker_id": {
     "type": "string",
     "minLength": 1
    },
    "job_id": {
     "type": "string",
     "minLength": 1
    },
    "disposition": {
     "enum": [
      "released",
      "unknown_job"
     ]
    },
    "message": {
     "type": "string"
    }
   }
  },
  "error": {
   "type": "object",
   "required": [
    "protocol_version",
    "type",
    "code",
    "message"
   ],
   "properties": {
    "protocol_version": {
     "const": 1
    },
    "type": {
     "const": "error"
    },
    "code": {
     "enum": [
      "poll_timeout",
      "protocol_version_mismatch",
      "malformed_message",
      "unknown_worker",
      "capacity_exceeded",
      "heartbeat_missed",
      "job_timeout",
      "registration_rejected"
     ]
    },
    "message": {
     "type": "string"
    },
    "retry_after_ms": {
     "type": "integer",
     "minimum": 0
    },
    "job_id": {
     "type": "string"
    }
   }
  }
 }
}
